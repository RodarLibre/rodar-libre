---
import { Font } from "astro:assets"
import Analytics from "@vercel/analytics/astro"
import { Navbar } from "@/components/navbar"
import "@/styles/globals.css"

interface Props {
  title?: string
  description?: string
  /** Páginas internas o de prueba: no se indexan ni entran al sitemap. */
  noindex?: boolean
}

const DEFAULT_TITLE = "Rodar Libre - La app para conductores y moteros en Colombia"
const DEFAULT_DESCRIPTION =
  "Rodar Libre es la app para moteros y conductores en Colombia: multas del SIMIT, SOAT, tecnomecánica, licencia y pico y placa de tu moto o carro, en un solo lugar."

const { title = DEFAULT_TITLE, description = DEFAULT_DESCRIPTION, noindex = false } = Astro.props

// URL canónica sin barra final (salvo el home), igual a como enlazamos las páginas.
const canonicalPath = Astro.url.pathname.replace(/\/+$/, "") || "/"
const canonicalUrl = new URL(canonicalPath, Astro.site).href
const siteUrl = new URL("/", Astro.site).href

// JPG y no WebP: varios lectores de enlaces (previsualizaciones en chats y redes) no muestran WebP.
const ogImage = new URL("/og-image.jpg", Astro.site).href
const OG_IMAGE_ALT = "Logo de Rodar Libre en letras blancas sobre fondo negro"

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "Rodar Libre",
      url: siteUrl,
      logo: new URL("/favicon/android-chrome-512x512.png", Astro.site).href,
      email: "hola@rodarlibre.co",
      areaServed: "CO",
      sameAs: [
        "https://www.instagram.com/rodarlibre.co/",
        "https://www.facebook.com/rodarlibre.co",
        "https://www.tiktok.com/@rodarlibre.co",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: "Rodar Libre",
      url: siteUrl,
      inLanguage: "es-CO",
      publisher: { "@id": `${siteUrl}#organization` },
    },
  ],
}
---

<!doctype html>
<html lang="es-CO" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Rodar Libre" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" sizes="180x180" type="image/png" />
    <link rel="icon" href="/favicon/android-chrome-192x192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/favicon/android-chrome-512x512.png" sizes="512x512" type="image/png" />

    <Font cssVariable="--font-montserrat" preload />
    <Font cssVariable="--font-open-sans" preload />
    <slot name="head" />
  </head>
  <body class="dark">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-primary-foreground"
    >
      Saltar al contenido
    </a>
    <Navbar client:load />
    <slot />
    <Analytics />
  </body>
</html>
