---
import { Font } from "astro:assets"
import Analytics from "@vercel/analytics/astro"
import { Navbar } from "@/components/navbar"
import "@/styles/globals.css"

interface Props {
  title?: string
  description?: string
}

const DEFAULT_TITLE = "Rodar Libre - La primera app para conductores en Colombia"
const DEFAULT_DESCRIPTION = "Rueda libre, vive la ruta, cuida tu vehículo. Síguenos en @rodarlibre.co"

const { title = DEFAULT_TITLE, description = DEFAULT_DESCRIPTION } = Astro.props

const OG_TITLE = "Rodar Libre - La APP para conductores en Colombia"
const OG_DESCRIPTION = "Rueda libre, vive la ruta, cuida tu vehículo. Síguenos en @rodarlibre.co"
const ogImage = new URL("/og-image.webp", Astro.site).href
---

<!doctype html>
<html lang="es" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <meta property="og:title" content={OG_TITLE} />
    <meta property="og:description" content={OG_DESCRIPTION} />
    <meta property="og:url" content="https://rodarlibre.co" />
    <meta property="og:site_name" content="Rodar Libre" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_TITLE} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={OG_TITLE} />
    <meta name="twitter:description" content={OG_DESCRIPTION} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" sizes="180x180" type="image/png" />
    <link rel="icon" href="/favicon/android-chrome-192x192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/favicon/android-chrome-512x512.png" sizes="512x512" type="image/png" />

    <Font cssVariable="--font-montserrat" preload />
    <Font cssVariable="--font-open-sans" preload />
    <slot name="head" />
  </head>
  <body class="dark">
    <Navbar client:load />
    <slot />
    <Analytics />
  </body>
</html>
