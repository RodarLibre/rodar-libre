---
import Layout from "@/layouts/Layout.astro"
import SiteFooter from "@/components/site-footer.astro"

const title = "No encontramos esta página - Rodar Libre"
const description = "La página que buscas no existe o cambió de lugar."
---

<Layout title={title} description={description} noindex>
  <div class="min-h-screen bg-background text-foreground">
    <div class="relative z-10">
      <main id="contenido" class="px-4 pt-32 pb-20 min-h-[75vh]">
        <div class="max-w-xl mx-auto text-center space-y-6">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-400">Error 404</p>
          <h1 class="font-serif font-black text-4xl leading-tight text-foreground text-balance">
            No encontramos esta página
          </h1>
          <p class="text-muted-foreground text-base text-pretty">
            El enlace puede estar mal escrito o la página ya no está.
          </p>
          <a
            href="/"
            class="inline-flex items-center justify-center h-12 px-6 rounded-2xl bg-primary text-primary-foreground font-bold hover:bg-primary/90 active:scale-95 transition-all"
          >
            Ir al inicio
          </a>
        </div>
      </main>
      <SiteFooter />
    </div>
  </div>
</Layout>
