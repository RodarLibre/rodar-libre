---
import fs from "node:fs"
import path from "node:path"

import Layout from "@/layouts/Layout.astro"
import { Card, CardContent } from "@/components/ui/card"
import { EngineOilIcon } from "@/components/ui/engine-oil-icon"
import { HelmetIcon } from "@/components/ui/helmet-icon"
// import { MaintenanceIcon } from "@/components/ui/maintenance-icon"
// import { MotorcycleIcon } from "@/components/ui/motorcycle-icon"
import { AlliesMarquee } from "@/components/allies-marquee"
import { AppShowcase, type AppScreen } from "@/components/app-showcase"
import { HeroShowcaseVideo } from "@/components/hero-showcase-video"
import { Fuel, Mountain, Users, Scale, Instagram, Linkedin, Github, Facebook, TrendingUp, Zap, MessageCircle, RefreshCw, CalendarX, IdCard, Wallet, Gauge } from "lucide-react"

// Textos tomados de la ficha de Google Play 1.24.0 (expo/store-assets/1.24.0/listing)
const features = [
  { icon: Scale, title: "Multas del SIMIT", body: "Consulta tus multas y comparendos, vehículo por vehículo" },
  {
    icon: RefreshCw,
    title: "SOAT y tecnomecánica",
    body: "Trae los datos de tu vehículo desde el RUNT y recibe recordatorios antes de que venzan",
  },
  {
    icon: CalendarX,
    title: "Pico y placa",
    body: "Revisa qué día tienes restricción en tu ciudad o en otras ciudades si estás de viaje",
  },
  {
    icon: IdCard,
    title: "Licencia y seguro todo riesgo",
    body: "Guarda la vigencia de tu pase por categoría y de tu seguro todo riesgo, y mira cuántos días les quedan",
  },
  { icon: Fuel, title: "Consumo de gasolina", body: "Registra cada tanqueada y mira cuántos km por galón te rinde" },
  {
    icon: EngineOilIcon,
    title: "Mantenimiento",
    body: "Lleva el control del cambio de aceite y otros mantenimientos, con avisos para el próximo",
  },
  {
    icon: Wallet,
    title: "¿Cuánto me cuesta mi moto?",
    body: "Lo que llevas gastado este mes en gasolina y mantenimiento",
  },
  {
    icon: Gauge,
    title: "Tablero",
    body: "La salud de tu moto o carro en un solo medidor, con tu siguiente paso, tu racha y tus logros",
  },
  { icon: HelmetIcon, title: "Aliados", body: "Talleres, tiendas, comunidades y eventos con descuentos" },
]

const allyPerks = [
  { icon: Users, label: "Miles de clientes potenciales" },
  { icon: TrendingUp, label: "Mayor visibilidad digital" },
  { icon: Zap, label: "Presencia en la app" },
]

// Texto alternativo por archivo. Las capturas sin entrada usan un alt genérico.
const appScreenAlts: Record<string, string> = {
  "01-tablero.webp":
    "Tablero de Rodar Libre con la salud de la moto, el kilometraje, el rendimiento y la racha semanal",
  "02-multas-simit.webp":
    "Consulta de multas del SIMIT en Rodar Libre sin multas pendientes y con alertas de multas nuevas",
  "03-pico-y-placa.webp":
    "Notificaciones de Rodar Libre con alertas de pico y placa, multas nuevas, SOAT, revisión técnico-mecánica y mantenimiento",
  "04-tu-go.webp":
    "Resumen de Tu Go con los avisos de pico y placa y las revisiones de multas de los últimos 30 días",
  "05-tu-progreso.webp":
    "Pantalla Tu progreso de Rodar Libre con la racha semanal y las tareas de la semana",
  "06-logros.webp":
    "Logros de Rodar Libre desbloqueados al cuidar la moto",
  "07-rendimiento.webp":
    "Logro de primer rendimiento en Rodar Libre con los kilómetros por galón de la moto",
}

// Las capturas se descubren en build: para agregar más basta subir la imagen a /public/app
function getAppScreens(): AppScreen[] {
  const dir = path.join(process.cwd(), "public", "app")
  return fs
    .readdirSync(dir)
    .filter((file) => /\.(png|jpe?g|webp|avif)$/i.test(file))
    .sort()
    .map((file) => ({
      src: `/app/${file}`,
      alt: appScreenAlts[file] ?? "Captura de pantalla de la app Rodar Libre",
    }))
}

const appJsonLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "Rodar Libre",
  operatingSystem: "iOS, Android",
  applicationCategory: "LifestyleApplication",
  description:
    "La app para conductores y moteros en Colombia: multas del SIMIT, SOAT, tecnomecánica, licencia de conducción y pico y placa de tu moto o tu carro, en un solo lugar.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "COP" },
  url: "https://rodarlibre.co",
  downloadUrl: [
    "https://apps.apple.com/us/app/rodarlibre/id6762035476",
    "https://play.google.com/store/apps/details?id=com.rodarlibre",
  ],
}

const whatsappNumber = "573195930092"
const whatsappMessage = encodeURIComponent("¡Hola! Me interesa ser aliado de Rodar Libre 🚀")
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`
const appScreens = getAppScreens()
