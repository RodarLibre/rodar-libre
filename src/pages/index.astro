---
import fs from "node:fs";
import path from "node:path";
import {
  Fuel,
  Users,
  TriangleAlert,
  Scale,
  Instagram,
  Linkedin,
  Github,
  Facebook,
  TrendingUp,
  Zap,
  MessageCircle,
  RefreshCw,
} from "lucide-react";

import { Card, CardContent } from "../components/ui/card";
import { EngineOilIcon } from "../components/ui/engine-oil-icon";
import { HelmetIcon } from "../components/ui/helmet-icon";
import AlliesMarquee from "../components/AlliesMarquee.astro";
import { AppShowcase } from "../components/AppShowcase";
import { HeroShowcaseVideo } from "../components/HeroShowcaseVideo";
import StarryBackground from "../components/StarryBackground.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { appScreenAlts, type AppScreen } from "../lib/app-screens";
import BaseLayout from "../layouts/BaseLayout.astro";

function getAppScreens(): AppScreen[] {
  const dir = path.join(process.cwd(), "public", "app");
  return fs
    .readdirSync(dir)
    .filter((file) => /\.(png|jpe?g|webp|avif)$/i.test(file))
    .sort()
    .map((file) => ({
      src: `/app/${file}`,
      alt: appScreenAlts[file] ?? "Captura de pantalla de la app RodarLibre",
    }));
}

const appScreens = getAppScreens();

const allyPerks = [
  { icon: Users, label: "Miles de clientes potenciales" },
  { icon: TrendingUp, label: "Mayor visibilidad digital" },
  { icon: Zap, label: "Presencia en la app" },
];

const team = [
  {
    name: "Juan Roa",
    role: "CEO, CTO & Founder, Software Engineer",
    photo: "/team/juan_roa.webp",
    alt: "Juan Roa",
    socials: [
      {
        Icon: Instagram,
        href: "https://instagram.com/thecameratherapy",
        label: "Instagram de Juan Roa",
      },
      {
        Icon: Linkedin,
        href: "https://linkedin.com/in/roadev",
        label: "LinkedIn de Juan Roa",
      },
      {
        Icon: Github,
        href: "https://github.com/roadev",
        label: "GitHub de Juan Roa",
      },
    ],
  },
  {
    name: "Tatiana Quiñonez",
    role: "ML & AI, Científica de datos, Matemática",
    photo: "/team/tatiana.webp",
    alt: "Tatiana Quiñonez",
    socials: [
      {
        Icon: Linkedin,
        href: "https://www.linkedin.com/in/tatiana-quinonez/",
        label: "LinkedIn de Tatiana Quiñonez",
      },
    ],
  },
  {
    name: "David Calle",
    role: "Senior QA",
    photo: "/team/david_calle.webp",
    alt: "David Calle",
    socials: [
      {
        Icon: Linkedin,
        href: "https://www.linkedin.com/in/jes%C3%BAs-david-calle-daza-936442218/",
        label: "LinkedIn de David Calle",
      },
    ],
  },
  {
    name: "Miguel Ángel Bolaños",
    role: "Senior Product & Visual Designer",
    photo: "/team/miguel.webp",
    alt: "Miguel Ángel Bolaños",
    socials: [
      {
        Icon: Linkedin,
        href: "https://www.linkedin.com/in/mab015/",
        label: "LinkedIn de Miguel Ángel Bolaños",
      },
    ],
  },
];

const whatsappNumber = "573195930092";
const whatsappMessage = encodeURIComponent(
  "¡Hola! Me interesa ser aliado de RodarLibre 🚀",
);
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

const appJsonLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "RodarLibre",
  operatingSystem: "iOS, Android",
  applicationCategory: "LifestyleApplication",
  description:
    "La primera app para conductores en Colombia. Registra tanqueadas, controla mantenimientos, guarda tus documentos y accede a beneficios con aliados.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "COP" },
  url: "https://rodarlibre.co",
  downloadUrl: [
    "https://apps.apple.com/us/app/rodarlibre/id6762035476",
    "https://play.google.com/store/apps/details?id=com.rodarlibre",
  ],
};
---

<BaseLayout>
  <StarryBackground />

  <main id="main" class="relative z-10">
    <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />

    <section id="hero" class="px-4 pt-32 pb-16 text-center scroll-mt-28">
      <div class="max-w-5xl mx-auto space-y-8">
        <div class="relative">
          <div
            class="absolute -inset-8 -z-10 rounded-full bg-emerald-500/10 blur-3xl"
            aria-hidden="true"
          >
          </div>
          <HeroShowcaseVideo client:load />
        </div>

        <div class="space-y-4">
          <h1
            class="font-sans text-lg font-normal text-muted-foreground leading-relaxed"
          >
            La primera app para conductores en Colombia.
            <br />
            <span class="text-primary font-medium"
              >Rueda libre, vive la ruta, cuida tu vehículo.</span
            >
          </h1>
        </div>
      </div>
    </section>

    <section id="download" class="px-4 py-16 bg-muted/20 scroll-mt-28">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <div
            class="flex flex-col items-center justify-center p-8 bg-card border border-border rounded-2xl h-full"
          >
            <a
              href="https://apps.apple.com/us/app/rodarlibre/id6762035476"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Descargar RodarLibre en App Store"
              class="block w-full"
            >
              <img
                src="/ios_banner.svg"
                alt="Descargar en App Store"
                width="200"
                height="60"
                class="w-full max-w-xs mx-auto hover:opacity-90 transition-opacity cursor-pointer object-contain"
              />
            </a>
          </div>

          <div
            class="flex flex-col items-center justify-center p-8 bg-card border border-border rounded-2xl h-full"
          >
            <a
              href="https://play.google.com/store/apps/details?id=com.rodarlibre"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Descargar RodarLibre en Google Play"
              class="block w-full"
            >
              <img
                src="/google-play-es.svg"
                alt="Google Play Store"
                width="200"
                height="60"
                class="w-full max-w-xs mx-auto hover:opacity-90 transition-opacity cursor-pointer object-contain"
              />
            </a>
          </div>
        </div>

        <div class="text-center">
          <h2 class="font-sans text-2xl text-primary font-bold leading-relaxed">
            Síguenos en redes sociales
          </h2>
        </div>

        <div class="flex justify-center gap-8 mt-8">
          <a
            href="https://instagram.com/rodarlibre.co/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-primary transition-colors"
            aria-label="Seguir a RodarLibre en Instagram"
          >
            <Instagram className="w-14 h-14" />
          </a>
          <a
            href="https://www.tiktok.com/@rodarlibre.co"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-primary transition-colors"
            aria-label="Seguir a RodarLibre en TikTok"
          >
            <svg
              class="w-14 h-14"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path
                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.facebook.com/rodarlibre.co"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted-foreground hover:text-primary transition-colors"
            aria-label="Seguir a RodarLibre en Facebook"
          >
            <Facebook className="w-14 h-14" />
          </a>
        </div>
      </div>
    </section>

    <section id="features" class="px-4 py-12 scroll-mt-28">
      <div class="max-w-4xl mx-auto">
        <h2
          class="font-serif font-bold text-2xl text-center mb-8 text-foreground"
        >
          ¿Qué puedes hacer?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <Card className="bg-card border-border">
            <CardContent className="p-6 text-center space-y-4">
              <div class="flex justify-center">
                <div class="p-3 bg-primary/10 rounded-lg">
                  <Fuel className="w-6 h-6 text-primary" />
                </div>
              </div>
              <div>
                <h3 class="font-sans font-semibold text-card-foreground">
                  Registro de tanqueadas
                </h3>
                <p class="text-sm text-muted-foreground">Ahorra dinero</p>
              </div>
            </CardContent>
          </Card>

          <Card className="bg-card border-border">
            <CardContent className="p-6 text-center space-y-4">
              <div class="flex justify-center">
                <div class="p-3 bg-primary/10 rounded-lg">
                  <EngineOilIcon className="w-6 h-6 text-primary" />
                </div>
              </div>
              <div>
                <h3 class="font-sans font-semibold text-card-foreground">
                  Control de cambios de aceite
                </h3>
                <p class="text-sm text-muted-foreground">
                  Mantén tu moto en perfecto estado
                </p>
              </div>
            </CardContent>
          </Card>

          <Card className="bg-card border-border">
            <CardContent className="p-6 text-center space-y-4">
              <div class="flex justify-center">
                <div class="p-3 bg-primary/10 rounded-lg">
                  <RefreshCw className="w-6 h-6 text-primary" />
                </div>
              </div>
              <div>
                <h3 class="font-sans font-semibold text-card-foreground">
                  Sincroniza tus datos con el RUNT
                </h3>
                <p class="text-sm text-muted-foreground">
                  No necesitas agregar tu vehículo manualmente
                </p>
              </div>
            </CardContent>
          </Card>

          <Card className="bg-card border-border">
            <CardContent className="p-6 text-center space-y-4">
              <div class="flex justify-center">
                <div class="p-3 bg-primary/10 rounded-lg">
                  <TriangleAlert className="w-6 h-6 text-primary" />
                </div>
              </div>
              <div>
                <h3 class="font-sans font-semibold text-card-foreground">
                  Notificaciones de vencimiento
                </h3>
                <p class="text-sm text-muted-foreground">
                  Recibe a tiempo notificaciones sobre vencimiento de tus
                  papeles
                </p>
              </div>
            </CardContent>
          </Card>

          <Card className="bg-card border-border">
            <CardContent className="p-6 text-center space-y-4">
              <div class="flex justify-center">
                <div class="p-3 bg-primary/10 rounded-lg">
                  <Scale className="w-6 h-6 text-primary" />
                </div>
              </div>
              <div>
                <h3 class="font-sans font-semibold text-card-foreground">
                  Consulta tus multas de tránsito
                </h3>
                <p class="text-sm text-muted-foreground">
                  Revisa si tienes multas en el SIMIT
                </p>
              </div>
            </CardContent>
          </Card>

          <Card className="bg-card border-border">
            <CardContent className="p-6 text-center space-y-4">
              <div class="flex justify-center">
                <div class="p-3 bg-primary/10 rounded-lg">
                  <HelmetIcon className="w-6 h-6 text-primary" />
                </div>
              </div>
              <div>
                <h3 class="font-sans font-semibold text-card-foreground">
                  Descuentos exclusivos
                </h3>
                <p class="text-sm text-muted-foreground">
                  Tenemos alianzas con talleres, tiendas y aseguradoras
                </p>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </section>

    <section id="app" class="px-4 py-12 bg-muted/20 scroll-mt-28">
      <div class="max-w-4xl mx-auto space-y-8">
        <div class="text-center space-y-3">
          <h2 class="font-serif font-bold text-2xl text-foreground">
            Nuestra App
          </h2>
          <p class="text-muted-foreground text-sm max-w-md mx-auto">
            Aliados, beneficios, eventos y todo lo que necesitas para rodar, en
            la palma de tu mano.
          </p>
        </div>
        <AppShowcase client:visible screens={appScreens} />
      </div>
    </section>

    <section id="aliados" class="px-4 py-12 scroll-mt-28">
      <div class="max-w-4xl mx-auto space-y-12">
        <div class="max-w-sm mx-auto">
          <div
            class="rounded-3xl border border-border bg-card overflow-hidden shadow-2xl shadow-black/20"
          >
            <div
              class="bg-gradient-to-br from-primary/20 via-primary/5 to-transparent px-8 pt-10 pb-8 text-center space-y-3 border-b border-border"
            >
              <p
                class="text-xs font-bold uppercase tracking-[0.2em] text-primary"
              >
                Aliados
              </p>
              <h2
                class="font-serif font-black text-4xl text-foreground leading-tight"
              >
                Llega a más
                <br />
                clientes
              </h2>
              <p class="text-muted-foreground text-sm">
                Haz que tu negocio crezca siendo parte de nuestros aliados
              </p>
            </div>

            <div class="px-8 py-6 space-y-4 border-b border-border">
              {
                allyPerks.map(({ icon: Icon, label }) => (
                  <div class="flex items-center gap-4">
                    <div class="p-2 bg-primary/10 rounded-xl flex-shrink-0">
                      <Icon className="w-5 h-5 text-primary" />
                    </div>
                    <span class="text-sm font-medium text-foreground">
                      {label}
                    </span>
                  </div>
                ))
              }
            </div>

            <div class="px-8 py-8 space-y-3 text-center">
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-3 w-full h-14 rounded-2xl bg-[#1FA855] hover:bg-[#188C47] active:scale-95 transition-all text-white font-bold text-lg shadow-lg shadow-[#1FA855]/25"
              >
                <MessageCircle className="w-6 h-6 fill-white/30" />
                Escríbenos por WhatsApp
              </a>
              <p class="text-xs text-muted-foreground">
                ¡Ponte en contacto con nosotros!
              </p>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <h3 class="font-serif font-bold text-xl text-center text-foreground">
            Ya confían en nosotros
          </h3>
          <AlliesMarquee />
        </div>
      </div>
    </section>

    <section id="team" class="px-4 py-12 bg-muted/20 scroll-mt-28">
      <div class="max-w-6xl mx-auto">
        <h2
          class="font-serif font-bold text-2xl text-center mb-8 text-foreground"
        >
          Nuestro Equipo
        </h2>
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 max-w-6xl mx-auto justify-items-center"
        >
          {
            team.map((member, idx) => (
              <Card className="bg-card border-border overflow-hidden max-w-xs w-full mx-auto">
                <CardContent className="p-0">
                  <div class="aspect-square relative">
                    <img
                      src={member.photo}
                      alt={member.alt}
                      loading={idx === 0 ? "eager" : "lazy"}
                      decoding="async"
                      class="absolute inset-0 w-full h-full object-cover"
                    />
                  </div>
                  <div class="p-6 text-center space-y-2">
                    <h3 class="font-sans font-semibold text-card-foreground text-xl">
                      {member.name}
                    </h3>
                    <p class="text-muted-foreground text-sm">{member.role}</p>
                    <div class="flex justify-center gap-4 pt-2">
                      {member.socials.map(({ Icon, href, label }) => (
                        <a
                          href={href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-muted-foreground hover:text-primary transition-colors"
                          aria-label={label}
                        >
                          <Icon className="w-5 h-5" />
                        </a>
                      ))}
                    </div>
                  </div>
                </CardContent>
              </Card>
            ))
          }
        </div>
      </div>
    </section>

    <section id="apoyan" class="px-4 py-12 scroll-mt-28">
      <div class="max-w-4xl mx-auto">
        <h2
          class="font-serif font-bold text-2xl text-center mb-8 text-foreground"
        >
          Apoyan
        </h2>
        <div class="flex justify-center">
          <a
            href="https://www.youtube.com/@Libresen2Ruedas/videos"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visitar el canal de YouTube de Libres en 2 Ruedas"
            class="block transition-opacity hover:opacity-80"
          >
            <img
              src="/libres_en_2_ruedas.jpeg"
              alt="Libres en 2 Ruedas"
              width="768"
              height="768"
              class="w-full max-w-[240px] mx-auto object-contain rounded-2xl"
            />
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
