---
import Layout from "@/layouts/Layout.astro"
import { AlliesMarquee } from "@/components/allies-marquee"
import { MessageCircle, Check, Bell, ShieldCheck, Smartphone, BarChart3, Store, CalendarDays } from "lucide-react"

const title = "Aliados - Rodar Libre"
const description =
  "Pon tu negocio frente a los moteros que usan Rodar Libre para llevar su moto al día. Planes desde gratis."

// Cifras agregadas de producción al 2026-10-30 (skill consulta-produccion, diagnostico.rb), redondeadas hacia
// abajo: 3.742 usuarios, 1.771 de 3.089 motos son 2024+, 1.106 con actividad en 30 días, COP 449,8 M en
// tanqueos y mantenimientos. Actualízalas junto con la fecha cuando se vuelva a medir.
const statsDate = "30 de octubre de 2026"
const stats = [
  { value: "3.700+", label: "moteros y conductores registrados" },
  { value: "57%", label: "de sus motos son modelo 2024 o más nuevas" },
  { value: "1.100+", label: "usuarios activos al mes" },
  { value: "$449 M", label: "pesos en gasolina y mantenimiento registrados en la app" },
]

const reasons = [
  {
    icon: Bell,
    title: "Siempre a la vista",
    body: "La app le avisa al motero cuando se vence el SOAT, la Tecno o le toca el mantenimiento. Ahí es cuando busca un taller o una tienda.",
  },
  {
    icon: ShieldCheck,
    title: "Cifras especializadas",
    body: "Sabemos qué marcas, modelos y cilindrajes tienen nuestros usuarios, siempre en cifras agregadas. Nunca compartimos sus datos personales.",
  },
  {
    icon: Smartphone,
    title: "La App más completa",
    body: "Multas, SOAT, Tecno, pico y placa, tanqueos, mantenimientos y las rodadas de los clubes, en un solo lugar. Tu negocio aparece ahí mismo.",
  },
]

const plans = [
  {
    icon: CalendarDays,
    name: "Clubes",
    who: "Clubes de moteros y organizadores de eventos",
    price: "Gratis",
    priceNote: "",
    perks: ["Perfil del club en la app", "Tus rodadas y eventos publicados", "Botón para unirse al club"],
    give: "Nos compartes en tus grupos y redes.",
    featured: false,
  },
  {
    icon: Store,
    name: "Básico",
    who: "Talleres, tiendas y servicios",
    price: "Gratis",
    priceNote: "",
    perks: [
      "Perfil en tu ciudad y categoría",
      "Botones de WhatsApp, mapa y redes",
      "Código de beneficio para saber quién llega de Rodar Libre",
    ],
    give: "Un beneficio para nuestros usuarios y nuestro QR en tu local.",
    featured: false,
  },
  {
    icon: BarChart3,
    name: "Destacado",
    who: "Negocios que quieren salir primero",
    price: "COP 50.000",
    priceNote: "al mes, o COP 500.000 al año",
    perks: [
      "Primero en tu ciudad y categoría",
      "Tus eventos destacados",
      "Reporte mensual de vistas, toques y códigos usados",
      "Todo lo del plan Básico",
    ],
    give: "",
    featured: true,
  },
]

const steps = [
  { n: "1", title: "Escríbenos", body: "Por WhatsApp, con el nombre de tu negocio y tu ciudad." },
  { n: "2", title: "Armamos tu perfil", body: "Con tu beneficio, tu código y tus canales de contacto." },
  { n: "3", title: "Mides", body: "Te mostramos cuántos te vieron, te escribieron y usaron tu código." },
]

const whatsappNumber = "573195930092"
const whatsappMessage = encodeURIComponent("¡Hola! Me interesa ser aliado de Rodar Libre")
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-background text-foreground">
    <div class="relative z-10">
      {/* Hero */}
      <section class="px-4 pt-32 pb-14">
        <div class="max-w-4xl mx-auto text-center space-y-6">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-400">Aliados</p>
          <h1 class="font-serif font-black text-4xl md:text-5xl leading-tight text-foreground text-balance">
            Tu negocio, en la App más completa para moteros
          </h1>
          <p class="text-muted-foreground text-base md:text-lg max-w-2xl mx-auto text-pretty">
            Los moteros revisan aquí sus multas, el SOAT, la Tecno y el pico y placa, registran tanqueos y
            mantenimientos, y cumplen metas por cuidar su moto. Rodar Libre los acompaña en todo. Este es tu lugar.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-3 w-full sm:w-auto h-12 px-6 rounded-2xl bg-[#1FA855] hover:bg-[#188C47] active:scale-95 transition-all text-white font-bold shadow-lg shadow-[#1FA855]/25"
            >
              <MessageCircle className="w-5 h-5 fill-white/30" />
              Escríbenos por WhatsApp
            </a>
            <a
              href="#planes"
              class="flex items-center justify-center w-full sm:w-auto h-12 px-6 rounded-2xl border border-border text-foreground font-semibold hover:bg-muted/40 transition-colors"
            >
              Ver planes
            </a>
          </div>
        </div>
      </section>

      {/* Current allies */}
      <section class="px-4 pb-14">
        <div class="max-w-4xl mx-auto space-y-6">
          <h2 class="font-serif font-bold text-xl text-center text-foreground">Ya confían en nosotros</h2>
          <AlliesMarquee />
        </div>
      </section>

      {/* Numbers */}
      <section class="px-4 pb-14">
        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            {stats.map(({ value, label }) => (
              <div class="rounded-2xl border border-border bg-muted/20 p-5">
                <p class="font-serif font-black text-3xl text-emerald-400">{value}</p>
                <p class="mt-2 text-sm text-muted-foreground leading-snug">{label}</p>
              </div>
            ))}
          </div>
          <p class="mt-3 text-xs text-muted-foreground text-center">Cifras agregadas de la base de Rodar Libre al {statsDate}.</p>
        </div>
      </section>

      {/* Why */}
      <section class="px-4 py-14 bg-muted/20">
        <div class="max-w-4xl mx-auto">
          <h2 class="font-serif font-bold text-2xl text-center mb-8 text-foreground">¿Por qué Rodar Libre?</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {reasons.map(({ icon: Icon, title, body }) => (
              <div class="rounded-2xl border border-border bg-card p-6 space-y-3">
                <div class="inline-flex p-2.5 bg-emerald-500/10 rounded-xl">
                  <Icon className="w-5 h-5 text-emerald-400" />
                </div>
                <h3 class="font-sans font-semibold text-card-foreground">{title}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">{body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Plans */}
      <section id="planes" class="px-4 py-14 scroll-mt-24">
        <div class="max-w-5xl mx-auto">
          <h2 class="font-serif font-bold text-2xl text-center mb-2 text-foreground">Planes</h2>
          <p class="text-center text-muted-foreground text-sm mb-8">Sin permanencia. Cambias o cancelas cuando quieras.</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-stretch">
            {plans.map(({ icon: Icon, name, who, price, priceNote, perks, give, featured }) => (
              <div
                class:list={[
                  "rounded-3xl border p-6 flex flex-col",
                  featured ? "border-emerald-500/60 bg-emerald-500/[0.06] shadow-xl shadow-emerald-500/10" : "border-border bg-card",
                ]}
              >
                <div class="flex items-center gap-3">
                  <div class="p-2 bg-emerald-500/10 rounded-xl">
                    <Icon className="w-5 h-5 text-emerald-400" />
                  </div>
                  <h3 class="font-serif font-bold text-xl text-foreground">{name}</h3>
                </div>
                <p class="mt-2 text-sm text-muted-foreground">{who}</p>
                <p class="mt-5 font-serif font-black text-3xl text-foreground">{price}</p>
                {priceNote && <p class="text-sm text-muted-foreground">{priceNote}</p>}
                <ul class="mt-5 space-y-2.5 flex-1">
                  {perks.map((perk) => (
                    <li class="flex gap-2.5 text-sm text-foreground">
                      <Check className="w-4 h-4 mt-0.5 flex-shrink-0 text-emerald-400" />
                      <span>{perk}</span>
                    </li>
                  ))}
                </ul>
                {give && (
                  <p class="mt-5 text-sm text-muted-foreground border-t border-border pt-4">
                    <span class="font-semibold text-foreground">A cambio:</span> {give}
                  </p>
                )}
                {featured && (
                  <div class="mt-5 rounded-2xl bg-emerald-500/10 p-4 text-sm leading-relaxed">
                    <p class="font-semibold text-emerald-300">Precio fundador</p>
                    <p class="text-foreground">
                      El primer mes es gratis y los 6 siguientes cuestan COP 35.000 al mes, si te unes antes del 30 de
                      noviembre de 2026.
                    </p>
                  </div>
                )}
              </div>
            ))}
          </div>
          <p class="mt-6 text-center text-sm text-muted-foreground">
            ¿Vendes motos o productos de alto valor? También trabajamos por comisión.{" "}
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-foreground underline underline-offset-4 hover:text-emerald-300">Hablemos</a>.
          </p>
        </div>
      </section>

      {/* How it works */}
      <section class="px-4 py-14 bg-muted/20">
        <div class="max-w-4xl mx-auto">
          <h2 class="font-serif font-bold text-2xl text-center mb-8 text-foreground">Cómo funciona</h2>
          <ol class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {steps.map(({ n, title, body }) => (
              <li class="rounded-2xl border border-border bg-card p-6">
                <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-emerald-500/15 text-emerald-300 font-bold">{n}</span>
                <h3 class="mt-4 font-sans font-semibold text-card-foreground">{title}</h3>
                <p class="mt-1 text-sm text-muted-foreground leading-relaxed">{body}</p>
              </li>
            ))}
          </ol>
          <p class="mt-8 max-w-2xl mx-auto text-center text-sm text-muted-foreground leading-relaxed">
            <span class="font-semibold text-foreground">Lo que no hacemos:</span> no vendemos ni compartimos datos
            personales de los usuarios, ni llenamos la app de anuncios. Solo referimos: el usuario te contacta
            directamente.
          </p>
        </div>
      </section>

      {/* Final CTA */}
      <section class="px-4 py-16">
        <div class="max-w-xl mx-auto text-center rounded-3xl border border-border bg-card p-8 space-y-4">
          <h2 class="font-serif font-black text-3xl text-foreground leading-tight">¿Hablamos?</h2>
          <p class="text-muted-foreground text-sm">Te respondemos por WhatsApp y armamos tu perfil en pocos días.</p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 w-full h-14 rounded-2xl bg-[#1FA855] hover:bg-[#188C47] active:scale-95 transition-all text-white font-bold text-lg shadow-lg shadow-[#1FA855]/25"
          >
            <MessageCircle className="w-6 h-6 fill-white/30" />
            Escríbenos por WhatsApp
          </a>
          <p class="text-xs text-muted-foreground">
            O escríbenos a <a href="mailto:hola@rodarlibre.co" class="underline underline-offset-4 hover:text-foreground">hola@rodarlibre.co</a>.
            Lee las <a href="/allies-conditions" class="underline underline-offset-4 hover:text-foreground">condiciones de aliados</a>.
          </p>
        </div>
      </section>

      <footer class="px-4 py-8 bg-background border-t border-border">
        <div class="max-w-xl mx-auto text-center space-y-3">
          <p class="text-sm text-muted-foreground">© 2026 Rodar Libre. Todos los derechos reservados.</p>
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
            <a href="/" class="text-muted-foreground hover:text-primary transition-colors">Inicio</a>
            <a href="/privacy" class="text-muted-foreground hover:text-primary transition-colors">Privacidad</a>
            <a href="/allies-conditions" class="text-muted-foreground hover:text-primary transition-colors">Condiciones de Aliados</a>
          </div>
        </div>
      </footer>
    </div>
  </div>
</Layout>
