---
const year = new Date().getFullYear();
---

<footer class="px-4 py-8 bg-background border-t border-border">
  <div class="max-w-xl mx-auto text-center space-y-4">
    <p class="text-sm text-muted-foreground">
      © {year} RodarLibre. Todos los derechos reservados.
    </p>
    <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
      <a
        href="/privacy"
        class="text-muted-foreground hover:text-primary transition-colors whitespace-nowrap"
        >Privacidad</a
      >
      <a
        href="/allies-conditions"
        class="text-muted-foreground hover:text-primary transition-colors whitespace-nowrap"
        >Condiciones de Aliados</a
      >
      <a
        href="https://instagram.com/rodarlibre.co/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground hover:text-primary transition-colors whitespace-nowrap"
        aria-label="Seguir a RodarLibre en Instagram (se abre en nueva ventana)"
        >Instagram</a
      >
      <a
        href="https://www.tiktok.com/@rodarlibre.co"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground hover:text-primary transition-colors whitespace-nowrap"
        aria-label="Seguir a RodarLibre en TikTok (se abre en nueva ventana)"
        >TikTok</a
      >
      <a
        href="https://app.rodarlibre.co"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground hover:text-primary transition-colors whitespace-nowrap"
        aria-label="Descarga la app">Descarga la App</a
      >
    </div>
  </div>
</footer>
